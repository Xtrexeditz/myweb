# XTrex Portfolio Backend Configuration

# Server Port
PORT=5000

# MongoDB Connection String
# For MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/xtrex_portfolio?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/xtrex_portfolio
MONGODB_URI=mongodb://127.0.0.1:27017/xtrex_portfolio

# Admin Dashboard Secret Key / PIN (Default: xtrex2026)
ADMIN_SECRET_KEY=xtrex2026

# Environment
NODE_ENV=development
